# ========================================================
# Sunset Group Lead Scraping & AI Validation System Config
# ========================================================

# Groq Cloud API Configuration (Required for AI Lead Validation)
GROQ_CLOUD_API_KEY=gsk_your_groq_api_key_here
MODEL_NAME=openai/gpt-oss-120b

# Optional OpenAI / LLM Configuration
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Search APIs (Optional - falls back to polite DuckDuckGo/Bing)
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# Scraper & Crawler Settings
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
RATE_LIMIT_DELAY_SECONDS=1.0
MAX_AGENT_ITERATIONS=10
HTTP_TIMEOUT_SECONDS=10.0
PLAYWRIGHT_TIMEOUT_MS=15000
